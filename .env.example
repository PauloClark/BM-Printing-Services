# Backend port for the Express server
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bmprinting

# JWT Authentication (change JWT_SECRET in production!)
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d

# Default admin account (only used during initial seed)
ADMIN_EMAIL=admin@bm.com
ADMIN_PASSWORD=admin123
